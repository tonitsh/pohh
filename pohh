echo "deb [signed-by=/usr/share/keyrings/derivative.asc] https://deb.kicksecure.com bullseye main contrib non-free" | sudo tee /etc/apt/sources.list.d/kicksecure-bullseye.list
sudo nano /etc/apt/preferences.d/kicksecure-bullseye.pref

  Package: *
Pin: release n=bullseye
Pin-Priority: 100



apt policy kicksecure-base kicksecure-sysctl

sudo apt install -t bullseye kicksecure-base kicksecure-sysctl

sudo apt install -t bullseye security-misc

sudo rm /etc/apt/sources.list.d/kicksecure-bullseye.list
sudo rm /etc/apt/preferences.d/kicksecure-bullseye.pref
sudo apt update


sudo dpkg --remove --force-remove-reinstreq security-misc

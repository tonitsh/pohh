sudo curl --tlsv1.3 --proto '=https' --max-time 15 \
  --output /usr/share/keyrings/kicksecure-archive-keyring.gpg \
  https://deb.kicksecure.com/kicksecure-archive-keyring.gpg

ls -l /usr/share/keyrings/kicksecure-archive-keyring.gpg


echo "deb [signed-by=/usr/share/keyrings/kicksecure-archive-keyring.gpg] https://deb.kicksecure.com bookworm main contrib non-free" | sudo tee /etc/apt/sources.list.d/kicksecure.list


gpg --show-keys /usr/share/keyrings/kicksecure-archive-keyring.gpg
